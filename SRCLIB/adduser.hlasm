         CVT   DSECT=YES,LIST=NO                                        00065900
         IKJCPPL                                                        00066000
         IKJUPT                                                         00066100
         IKJPPL                        Parse parameter list             00066200
PPL#L    EQU   *-PPL                                                    00066300
         IKJDAPL                                                        00066400
         IKJDAP08                      IKJDAIR allocation parm block    00066500
         IKJDAP18                      IKJDAIR unallocation parm block  00066600
         PRINT NOGEN                                                    00066700
         DCBD  DSORG=PS,DEVD=DA                                         00066800
